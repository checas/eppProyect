---
import Layout from '../layouts/Layout.astro';
import logoHorizontal from '../assets/logo-horizontal.png';
import whatsappLogo from '../assets/whatsapp_logo.svg';

type BrandLogoModule = string | { src: string };
const brandLogoModules = import.meta.glob<BrandLogoModule>('../assets/brand-*.{png,jpg,jpeg,webp,svg}', { eager: true, import: 'default' });
const brandLogos = Object.entries(brandLogoModules)
	.map(([path, mod]) => {
		const filename = path.split('/').pop() ?? '';
		const alt = filename.replace(/^brand-/, '').replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ').trim();
		const src = typeof mod === 'string' ? mod : mod.src;
		return { src, alt };
	})
	.sort((a, b) => a.alt.localeCompare(b.alt));

const waNumber = '5492644399189';
const waLink = (text: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;
