---
import Layout from '../layouts/Layout.astro';
import logoHorizontal from '../assets/logo-horizontal.png';
import whatsappLogo from '../assets/whatsapp_logo.svg';
import catalogoProducts from '../data/catalogo.json';

const waNumber = '5492644399189';
const waLink = (text: string) => `https://wa.me/${waNumber}?text=${encodeURIComponent(text)}`;

const products = catalogoProducts;

const uniqueSorted = (items: string[]) => Array.from(new Set(items.map((s) => s.trim()).filter(Boolean))).sort((a, b) => a.localeCompare(b));
const categories = uniqueSorted(products.map((p) => p.category ?? ''));
const brandsRaw = products.map((p) => (p.brand ?? '').trim());
const hasGenericBrand = brandsRaw.some((b) => !b);
const brands = uniqueSorted(brandsRaw.filter(Boolean));
---

<Layout title="Catálogo | EPP TOTAL">
	<header class="sticky top-0 z-50 bg-white dark:bg-background-dark/95 backdrop-blur-md border-b border-primary/20 shadow-sm">
		<div class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between">
			<div class="flex items-center gap-8">
				<a class="flex items-center gap-3" href="/">
					<img src={logoHorizontal.src} alt="EPP TOTAL" class="h-8 w-auto" loading="eager" />
				</a>
				<nav class="hidden lg:flex items-center gap-6 text-sm font-medium">
					<a class="hover:text-primary transition-colors text-slate-500 dark:text-slate-400" href="/">Inicio</a>
					<a class="hover:text-primary transition-colors border-b-2 border-primary pb-1" href="/catalogo">Catálogo</a>
				</nav>
			</div>
			<div class="hidden md:flex items-center gap-4 flex-1 max-w-md ml-8">
				<div class="relative w-full">
					<input
						class="w-full bg-slate-100 dark:bg-slate-800 border-none rounded-xl py-2.5 pl-4 pr-10 text-sm focus:ring-2 focus:ring-primary/50"
						placeholder="Buscar protección, calzado o marca..."
						type="text"
						id="search-input"
					/>
					<span class="material-icons absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 text-base">search</span>
				</div>
			</div>
			<div class="flex items-center gap-4 ml-6">
				<button class="flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-xl font-semibold hover:bg-primary hover:text-white transition-all">
					<span class="material-icons text-sm">download</span>
					<span class="text-sm">Catálogo PDF</span>
				</button>
			</div>
		</div>
	</header>

	<main class="max-w-7xl mx-auto px-4 py-8 bg-background-light dark:bg-background-dark min-h-[calc(100vh-5rem)]">
		<div class="flex gap-8">
			<aside class="w-64 flex-shrink-0 hidden lg:block">
				<div class="sticky top-28 space-y-8">
					<div>
						<h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Categoría</h3>
						<div class="space-y-2">
							{categories.map((c) => (
								<label class="flex items-center gap-3 cursor-pointer group">
									<input
										type="checkbox"
										checked
										value={c}
										data-filter-category
										class="rounded border-slate-300 text-primary focus:ring-primary"
									/>
									<span class="text-sm text-slate-600 dark:text-slate-400 group-hover:text-primary transition-colors">{c}</span>
								</label>
							))}
						</div>
					</div>
					<div class="pt-6 border-t border-slate-200 dark:border-slate-800">
						<h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-4">Marca</h3>
						<div class="space-y-2">
							{brands.map((b) => (
								<label class="flex items-center gap-3 cursor-pointer group">
									<input
										type="checkbox"
										checked
										value={b}
										data-filter-brand
										class="rounded border-slate-300 text-primary focus:ring-primary"
									/>
									<span class="text-sm text-slate-600 dark:text-slate-400 group-hover:text-primary transition-colors">{b}</span>
								</label>
							))}
							{hasGenericBrand ? (
								<label class="flex items-center gap-3 cursor-pointer group">
									<input
										type="checkbox"
										checked
										value="Generico"
										data-filter-brand
										class="rounded border-slate-300 text-primary focus:ring-primary"
									/>
									<span class="text-sm text-slate-600 dark:text-slate-400 group-hover:text-primary transition-colors">Genérico</span>
								</label>
							) : null}
						</div>
					</div>
				</div>
			</aside>

			<div class="flex-1">
				<div class="flex items-center justify-between mb-6">
					<p class="text-sm text-slate-500 dark:text-slate-400">
						Mostrando <span id="results-count" class="font-bold text-slate-800 dark:text-white">{products.length}</span> productos
					</p>
					<div class="flex items-center gap-4">
						<select class="bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 rounded-xl text-sm focus:ring-primary py-1.5">
							<option>Ordenar por: Relevancia</option>
							<option>Más recientes</option>
							<option>Marca A-Z</option>
						</select>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
					{products.map((p) => (
						<button
							type="button"
							class="text-left group bg-white dark:bg-slate-900 rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 hover:border-primary transition-all duration-300"
							data-product
							data-category={p.category}
							data-brand={p.brand}
							data-brand-filter={(p.brand?.trim() ? p.brand.trim() : 'Generico')}
							data-name={p.name}
							data-description={p.description}
							data-features={JSON.stringify(p.features ?? [])}
							data-image={p.productImage}
						>
							<div class="relative h-56 bg-slate-50 dark:bg-slate-800 overflow-hidden">
								<div class="absolute inset-0 bg-gradient-to-tr from-primary/10 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
								<img src={p.productImage} alt={p.name} class="w-full h-full object-contain p-8 group-hover:scale-[1.03] transition-transform" loading="lazy" />
							</div>
							<div class="p-5">
								<p class="text-[10px] font-bold text-primary tracking-widest uppercase mb-2">{p.category}</p>
								<div class="flex items-center justify-between gap-4 mb-2">
									<span class="text-[10px] font-bold text-slate-500 dark:text-white/70 tracking-widest uppercase">{p.brand}</span>
								</div>
								<h3 class="font-bold text-lg mb-4 leading-tight text-deep-blue dark:text-white">{p.name}</h3>
								<div class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2 transition-colors">
									<img src={whatsappLogo.src} alt="WhatsApp" class="w-5 h-5" loading="lazy" />
									Consultar ahora
								</div>
							</div>
						</button>
					))}
				</div>
			</div>
		</div>
	</main>

	<dialog
		id="product-modal"
		class="backdrop:bg-black/50 backdrop:backdrop-blur-sm fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(42rem,calc(100vw-2rem))] max-h-[calc(100vh-2rem)] overflow-auto rounded-3xl p-0 border border-gray-100 dark:border-zinc-800 bg-white dark:bg-zinc-900"
	>
		<div class="p-6 sm:p-8">
			<div class="flex items-start justify-between gap-6 mb-6">
				<div>
					<p id="product-modal-category" class="text-[10px] font-bold text-primary tracking-widest uppercase mb-2"></p>
					<p id="product-modal-brand" class="text-[10px] font-bold text-slate-500 dark:text-white/70 tracking-widest uppercase"></p>
					<h2 id="product-modal-name" class="text-2xl sm:text-3xl font-bold text-deep-blue dark:text-white leading-snug"></h2>
				</div>
				<button
					type="button"
					data-close-modal
					class="w-11 h-11 rounded-full border border-gray-200 dark:border-zinc-800 text-gray-500 dark:text-white/70 hover:border-primary/50 hover:text-primary transition-colors inline-flex items-center justify-center"
					aria-label="Cerrar"
				>
					<span class="material-icons">close</span>
				</button>
			</div>

			<div class="rounded-2xl overflow-hidden bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 mb-6">
				<img id="product-modal-image" alt="" class="w-full h-72 object-contain p-8" />
			</div>
			<div id="product-modal-features-wrapper" class="mt-6 hidden">
				<h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Características</h3>
				<ul id="product-modal-features" class="space-y-2 text-sm text-gray-600 dark:text-white/70"></ul>
			</div>
			<div id="product-modal-description-wrapper" class="mt-6">
				<h3 class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-3">Descripción</h3>
				<p id="product-modal-description" class="text-sm text-gray-600 dark:text-white/70 leading-relaxed"></p>
			</div>
			<div class="mt-8 flex flex-col sm:flex-row gap-3">
				<a
					id="product-modal-whatsapp"
					href={waLink('Hola, quisiera consultar por este producto')}
					class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 rounded-xl flex items-center justify-center gap-2 transition-colors"
				>
					<img src={whatsappLogo.src} alt="WhatsApp" class="w-5 h-5" loading="lazy" />
					Consultar ahora
				</a>
				<button
					type="button"
					data-close-modal
					class="flex-1 bg-primary/10 text-primary hover:bg-primary hover:text-white font-bold py-3 rounded-xl transition-colors"
				>
					Cerrar
				</button>
			</div>
		</div>
	</dialog>

	<script>
		// @ts-check
		(() => {
			const modal = document.getElementById('product-modal');
			if (!(modal instanceof HTMLDialogElement)) return;
			const resultsCount = document.getElementById('results-count');

			const categoryEl = document.getElementById('product-modal-category');
			const brandEl = document.getElementById('product-modal-brand');
			const nameEl = document.getElementById('product-modal-name');
			const descWrapperEl = document.getElementById('product-modal-description-wrapper');
			const descEl = document.getElementById('product-modal-description');
			const featuresWrapperEl = document.getElementById('product-modal-features-wrapper');
			const featuresEl = document.getElementById('product-modal-features');
			const imgEl = document.getElementById('product-modal-image');
			const waEl = document.getElementById('product-modal-whatsapp');

			if (!(categoryEl instanceof HTMLElement)) return;
			if (!(brandEl instanceof HTMLElement)) return;
			if (!(nameEl instanceof HTMLElement)) return;
			if (!(descWrapperEl instanceof HTMLElement)) return;
			if (!(descEl instanceof HTMLElement)) return;
			if (!(featuresWrapperEl instanceof HTMLElement)) return;
			if (!(featuresEl instanceof HTMLUListElement)) return;
			if (!(imgEl instanceof HTMLImageElement)) return;
			if (!(waEl instanceof HTMLAnchorElement)) return;
			if (!(resultsCount instanceof HTMLElement)) return;

			const closeButtons = modal.querySelectorAll('[data-close-modal]');
			closeButtons.forEach((btn) => {
				btn.addEventListener('click', () => modal.close());
			});

			modal.addEventListener('click', (e) => {
				const target = e.target;
				if (target === modal) modal.close();
			});

			const cards = document.querySelectorAll('[data-product]');
			cards.forEach((card) => {
				card.addEventListener('click', () => {
					if (!(card instanceof HTMLElement)) return;
					const category = card.getAttribute('data-category') ?? '';
					const brand = card.getAttribute('data-brand') ?? '';
					const name = card.getAttribute('data-name') ?? '';
					const description = card.getAttribute('data-description') ?? '';
					const featuresRaw = card.getAttribute('data-features') ?? '[]';
					const image = card.getAttribute('data-image') ?? '';

					categoryEl.textContent = category;
					brandEl.textContent = brand;
					nameEl.textContent = name;
					descEl.textContent = description;
					descWrapperEl.classList.toggle('hidden', !description.trim());
					imgEl.src = image;
					imgEl.alt = name;

					featuresEl.innerHTML = '';
					let features = [];
					try {
						features = JSON.parse(featuresRaw);
					} catch {
						features = [];
					}
					if (Array.isArray(features)) {
						const clean = features.map((f) => (f ?? '').toString().trim()).filter(Boolean);
						clean.forEach((f) => {
							const li = document.createElement('li');
							li.className = 'flex gap-3';
							const icon = document.createElement('span');
							icon.className = 'material-icons text-primary text-base leading-5';
							icon.textContent = 'check_circle';
							const text = document.createElement('span');
							text.textContent = f;
							li.appendChild(icon);
							li.appendChild(text);
							featuresEl.appendChild(li);
						});
						featuresWrapperEl.classList.toggle('hidden', clean.length === 0);
					} else {
						featuresWrapperEl.classList.add('hidden');
					}

					waEl.href = `https://wa.me/5492644399189?text=${encodeURIComponent(`Hola, quisiera consultar por el producto: ${name}`)}`;

					modal.showModal();
				});
			});

			const categoryInputs = Array.from(document.querySelectorAll('input[data-filter-category]')).filter(
				(el) => el instanceof HTMLInputElement
			);
			const brandInputs = Array.from(document.querySelectorAll('input[data-filter-brand]')).filter(
				(el) => el instanceof HTMLInputElement
			);
			const searchInput = document.getElementById('search-input');

			const norm = (v: string | null | undefined) => (v ?? '').toString().trim().toLowerCase();

			const applyFilters = () => {
				const selectedCats = new Set(categoryInputs.filter((i) => i.checked).map((i) => norm(i.value)));
				const selectedBrands = new Set(brandInputs.filter((i) => i.checked).map((i) => norm(i.value)));
				const q = searchInput instanceof HTMLInputElement ? norm(searchInput.value) : '';

				const catsActive = selectedCats.size > 0;
				const brandsActive = selectedBrands.size > 0;

				let visible = 0;
				cards.forEach((card) => {
					if (!(card instanceof HTMLElement)) return;
					const c = norm(card.getAttribute('data-category'));
					const b = norm(card.getAttribute('data-brand-filter'));
					const n = norm(card.getAttribute('data-name'));
					const d = norm(card.getAttribute('data-description'));
					const okCat = !catsActive || selectedCats.has(c);
					const okBrand = !brandsActive || selectedBrands.has(b);
					const okQuery = !q || n.includes(q) || d.includes(q) || c.includes(q) || b.includes(q);
					const show = okCat && okBrand && okQuery;
					card.classList.toggle('hidden', !show);
					if (show) visible += 1;
				});

				resultsCount.textContent = String(visible);
			};

			categoryInputs.forEach((i) => i.addEventListener('change', applyFilters));
			brandInputs.forEach((i) => i.addEventListener('change', applyFilters));
			if (searchInput instanceof HTMLInputElement) searchInput.addEventListener('input', applyFilters);
			applyFilters();
		})();
	</script>

	<footer id="contacto" class="bg-white dark:bg-background-dark pt-24 pb-12 px-6 border-t border-gray-100 dark:border-zinc-800">
		<div class="max-w-7xl mx-auto">
			<div class="grid grid-cols-1 md:grid-cols-1 gap-16 md:gap-24 mb-16">
				<div class="col-span-1 md:col-span-1">
					<div class="flex items-center space-x-2 mb-8">
						<img src={logoHorizontal.src} alt="EPP TOTAL" class="h-9 w-auto" loading="lazy" />
					</div>
					<p class="text-gray-500 text-sm leading-relaxed mb-8">
						Líderes en suministro y consultoría de seguridad industrial para empresas de alto rendimiento en toda la región.
					</p>
					<a class="inline-flex items-center text-sm text-gray-500 hover:text-primary transition-colors mb-8" href="mailto:contacto@epptotal.com.ar">
						contacto@epptotal.com.ar
					</a>
					<div class="flex space-x-4">
						<a
							class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:border-primary hover:text-primary transition-all"
							href="#"
						>
							<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
								<path
									d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
								></path>
							</svg>
						</a>
						<a
							class="w-10 h-10 rounded-full border border-gray-200 flex items-center justify-center text-gray-400 hover:border-primary hover:text-primary transition-all"
							href="#"
						>
							<svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
								<path
									d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.84 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
								></path>
							</svg>
						</a>
					</div>
				</div>
			</div>
			<div class="border-t border-gray-100 dark:border-zinc-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
				<p class="text-xs text-gray-400">© 2026 EPP TOTAL S.A. Todos los derechos reservados.</p>
				<div class="flex space-x-6 text-xs text-gray-400">
					<a class="hover:text-primary" href="/terminos">Términos</a>
					<a class="hover:text-primary" href="/privacidad">Privacidad</a>
					<a class="hover:text-primary" href="/cookies">Cookies</a>
				</div>
			</div>
		</div>
	</footer>

	<a class="fixed bottom-8 right-8 z-[100] group" href={waLink('Hola, quisiera consultar sobre asesoría técnica')} target="_blank" rel="noopener noreferrer">
		<div class="absolute -top-12 right-0 bg-white dark:bg-slate-800 text-slate-800 dark:text-white px-4 py-1.5 rounded-xl shadow-xl text-xs font-bold whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity border border-primary/20 pointer-events-none">
			¿Necesitas asesoramiento técnico?
		</div>
		<div class="bg-emerald-500 w-16 h-16 rounded-full flex items-center justify-center shadow-2xl hover:scale-110 transition-transform active:scale-95">
			<img src={whatsappLogo.src} alt="WhatsApp" class="w-8 h-8" loading="lazy" />
		</div>
	</a>
</Layout>
